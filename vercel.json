{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc/[...path].ts": {
      "maxDuration": 30
    },
    "api/amplopay/webhook.ts": {
      "maxDuration": 30
    }
  }
}
